# Copy to .env on the Pi and fill in. Never commit .env.
TUTOR_EMAIL=your_email_here
TUTOR_PASSWORD=your_password_here

# Where run.sh uploads logs and screenshots, e.g. s3://my-bucket-name
S3_BUCKET=s3://your-bucket-name

# Which hours to book: regular (Wed/Thu evenings) or sunday
SCHEDULE=regular
